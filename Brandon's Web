<style>
:root{
--bg: #0b0d12;
--panel: #11141b;
--soft: #1a1f29;
--text: #e9eef7;
--muted: #a7b0c2;
--brand: #63a3ff;
--accent: #8bd5ff;
--ok: #22c55e;
--warn:#f59e0b;
--chip:#1e2532;
--ring: 0 0 0 3px color-mix(in oklab, var(--brand) 35%, transparent);
--radius: 14px;
--shadow: 0 10px 30px rgba(0,0,0,.35);
--maxw: 1080px;
}
*{box-sizing:border-box}
html,body{margin:0;background:linear-gradient(180deg,#0a0c10,#0c1119 40%,#0a0c10);color:var(--text);font:500 16px/1.6 Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
.wrap{max-width:var(--maxw);margin:auto;padding:24px}
header{
position:sticky;top:0;z-index:50;background:linear-gradient(180deg,rgba(11,13,18,.9),rgba(11,13,18,.6));
backdrop-filter: blur(10px);border-bottom:1px solid #1d2330
}
.topbar{display:flex;gap:16px;align-items:center;justify-content:space-between;padding:12px 24px;max-width:var(--maxw);margin:auto}
.id{display:flex;gap:14px;align-items:center}
.avatar{
width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,#222a38,#141923);
display:grid;place-items:center;color:#9db4d6;font-weight:700
}
.name h1{margin:0;font-size:18px;letter-spacing:.2px}
.name small{display:block;margin-top:2px;color:var(--muted)}
.cta{display:flex;gap:10px;flex-wrap:wrap}
.btn{
appearance:none;border:1px solid #253046;background:var(--soft);color:var(--text);
padding:8px 14px;border-radius:12px;cursor:pointer;transition:.2s box-shadow,.2s transform,.2s border-color
}
.btn:hover{box-shadow:var(--ring)}
.btn.primary{background:linear-gradient(180deg,var(--brand),#4d87dd);border-color:#3b6eb6;color:#071426}
.btn.ghost{background:transparent}
.grid{
display:grid;grid-template-columns: 280px 1fr;gap:24px;margin-top:24px
}
@media (max-width: 900px){
.grid{grid-template-columns:1fr}
.side{order:2}
}
.panel{
background:linear-gradient(180deg,#0f131b,#0c1118 45%,#0b0f16);
border:1px solid #1c2432;border-radius:var(--radius);box-shadow:var(--shadow)
}
.side{position:sticky;top:84px;height:fit-content}
.card{padding:20px 18px;border-bottom:1px solid #182030}
.card:last-child{border-bottom:0}
.h{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.h h2{margin:0;font-size:15px;text-transform:uppercase;letter-spacing:.14em;color:#9fb6d6}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{
font-size:12px;padding:6px 10px;border-radius:999px;background:var(--chip);border:1px solid #27324a;color:#c4d1e9
}
.highlightbar{display:flex;gap:8px;flex-wrap:wrap}
.toggle{
appearance:none;border:1px solid #29344d;background:#111723;color:#cdd9ee;
padding:7px 12px;border-radius:999px;cursor:pointer
}
.toggle.active{background:linear-gradient(180deg,#20324d,#1a2a43);border-color:#34507e;box-shadow:var(--ring)}
.main .section{margin-bottom:20px}
.section .head{
padding:18px 20px;border-bottom:1px solid #182030;display:flex;justify-content:space-between;align-items:center
}
.section .head h3{margin:0;font-size:18px}
.items{padding:14px}
.item{
padding:16px;border:1px solid #1b2333;border-radius:12px;background:linear-gradient(180deg,#0e1420,#0d131d);
margin-bottom:12px;transition:.2s transform,.2s border-color
}
.item:hover{transform:translateY(-2px);border-color:#2a3752}
.item .title{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.item .title h4{margin:0;font-size:16px}
.meta{color:var(--muted);font-size:14px;margin-top:4px}
.bullets{margin:10px 0 0 0;padding-left:18px}
.bullets li{margin:8px 0}
.tagline{color:#cfe2ff}
.pill{font-size:11px;border:1px solid #2b3753;padding:4px 8px;border-radius:999px;background:#121a27;color:#a8c1ef}
.split{display:flex;gap:10px;flex-wrap:wrap}
.skills{display:flex;flex-wrap:wrap;gap:8px}
.statrow{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
@media (max-width:700px){.statrow{grid-template-columns:1fr 1fr}}
.stat .n{font-weight:800;font-size:22px}
.stat{padding:12px;border:1px solid #1b2333;border-radius:12px;background:#0f1521}
.note{color:var(--muted);font-size:13px}
.search{position:relative}
.search input{
width:100%;padding:10px 12px 10px 36px;border-radius:10px;border:1px solid #27324a;background:#0e1420;color:var(--text)
