}

function renderStats(){
const root = $("#stats"); root.innerHTML='';
DATA.stats.forEach(s=>{
const card = el('div',{class:'stat'},
el('div',{class:'n'}, s.value),
el('div',{class:'note'}, s.label)
);
root.appendChild(card);
});
}

// ======= INTERACTIONS =====================================================
function setHighlight(key){
const allItems = $$(".item");
const allBullets = $$(".bullets li");

// reset
allItems.forEach(i=> i.classList.remove('dim','hit'));
allBullets.forEach(b=> b.classList.remove('dim','hit'));

if(key==='all'){ return; }

const match = (node)=> (node.getAttribute('data-tags')||'').split(',').includes(key);

// Dim non-matching; highlight matches
allItems.forEach(i=>{
const tags = (i.getAttribute('data-tags')||'').split(',');
if(!tags.includes(key)){
i.classList.add('dim');
}else{
i.classList.add('hit');
}
});
allBullets.forEach(b=>{
if(!match(b)) b.classList.add('dim'); else b.classList.add('hit');
});
}

function wireHighlightBar(){
$$("#highlightBar .toggle").forEach(btn=>{
btn.addEventListener('click', ()=>{
$$("#highlightBar .toggle").forEach(b=> b.classList.remove('active'));
btn.classList.add('active');
setHighlight(btn.dataset.key);
});
});
}

function wireSearch(){
$("#search").addEventListener('input', (e)=>{
const q = e.target.value.trim().toLowerCase();
const sections = $$(".section .items");
sections.forEach(sec=>{
$$(".item", sec).forEach(item=>{
const text = item.textContent.toLowerCase();
item.style.display = text.includes(q) ? '' : 'none';
});
});
});
}

function wirePrint(){
$("#printBtn").addEventListener('click', ()=> window.print());
}

function wireExport(){
$("#downloadJSON").addEventListener('click', ()=>{
const blob = new Blob([JSON.stringify(DATA,null,2)], {type:'application/json'});
const url = URL.createObjectURL(blob);
const a = document.createElement('a');
a.href = url; a.download = 'profile-data.json'; a.click();
URL.revokeObjectURL(url);
});
}

// ======= INIT =============================================================
