.search svg{position:absolute;left:10px;top:50%;transform:translateY(-50%);opacity:.7}
.footer{margin:30px 0;color:var(--muted);text-align:center}
/* highlight states */
.dim{opacity:.35;filter:saturate(.6)}
.hit{outline:2px solid color-mix(in oklab,var(--brand) 55%, transparent);outline-offset:2px}
/* print */
@media print{
header,.side .card:nth-child(2){display:none}
body{background:white;color:black}
.panel{border:0;box-shadow:none}
a{text-decoration:none;color:inherit}
}
</style>
