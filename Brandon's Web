el('div',{class:'meta'}, e.credential + (e.dates? ` • ${e.dates}`:'')),
e.bullets ? el('ul',{class:'bullets'}, ...e.bullets.map(b=> el('li',{}, b))) : null
);
root.appendChild(item);
});
}

